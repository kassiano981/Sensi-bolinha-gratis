let platAtivo = 'android', marcaAtiva = 'Samsung', nivelAtivo = 'media'
const listaMarcas = document.getElementById('listaMarcas'), selModelo = document.getElementById('modelo')
function aleatorio(min,max){return Math.floor(Math.random()*(max-min+1))+min}
function atualizarMarcas(){
  listaMarcas.innerHTML=''
  Object.keys(dados[platAtivo]).forEach(marca=>{
    const b=document.createElement('button')
    b.className='marca'+(marca===marcaAtiva?' ativo':'')
    b.textContent=marca
    b.onclick=()=>{marcaAtiva=marca;atualizarMarcas();atualizarModelos()}
    listaMarcas.appendChild(b)
  })
}
function atualizarModelos(){
  selModelo.innerHTML=''
  dados[platAtivo][marcaAtiva].modelos.forEach(mod=>{
    const o=document.createElement('option');o.value=mod;o.textContent=mod;selModelo.appendChild(o)
  })
}
document.querySelectorAll('.botao-plat').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.botao-plat').forEach(x=>x.classList.remove('ativo'))
  b.classList.add('ativo');platAtivo=b.dataset.plat
  marcaAtiva=Object.keys(dados[platAtivo])[0];atualizarMarcas();atualizarModelos()
})
document.querySelectorAll('.nivel').forEach(b=>b.onclick=()=>{
  document.querySelectorAll('.nivel').forEach(x=>x.classList.remove('ativo'))
  b.classList.add('ativo');nivelAtivo=b.dataset.nivel
})
document.getElementById('btnGerar').onclick=()=>{
  const d=dados[platAtivo][marcaAtiva]
  const ajuste={baixa:{s:-18,d:-50},media:{s:0,d:0},alta:{s:26,d:90}}[nivelAtivo]
  const geral=Math.min(200,Math.max(80,d.baseGeral+ajuste.s+aleatorio(-3,3)))
  const ponto=Math.min(200,Math.max(80,geral+aleatorio(3,8)))
  const x2=Math.min(200,Math.max(80,geral-aleatorio(3,8)))
  const x4=Math.min(200,Math.max(60,geral-aleatorio(12,20)))
  const sniper=Math.min(200,Math.max(30,geral-aleatorio(24,34)))
  const olho=Math.min(200,Math.max(80,geral+aleatorio(6,12)))
  const dpiBase=d.baseDpi+ajuste.d
  document.getElementById('vGeral').textContent=geral
  document.getElementById('vPonto').textContent=ponto
  document.getElementById('v2x').textContent=x2
  document.getElementById('v4x').textContent=x4
  document.getElementById('vSniper').textContent=sniper
  document.getElementById('vOlho').textContent=olho
  document.getElementById('dpiSeguro').textContent=dpiBase-60
  document.getElementById('dpiMelhor').textContent=dpiBase+aleatorio(-10,20)
  document.getElementById('dpiExtremo').textContent=dpiBase+90
  document.getElementById('resultado').classList.add('mostrar')
}
document.getElementById('btnNova').onclick=()=>document.getElementById('resultado').classList.remove('mostrar')
